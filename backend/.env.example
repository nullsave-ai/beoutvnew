DATABASE_URL=postgres://beout:beout@localhost:5432/beout
REDIS_URL=redis://127.0.0.1:6379
BIND=0.0.0.0:8080
# حساب المسؤول الأول (يُنشأ مرة واحدة إذا لم يوجد مسؤول). كلمة المرور 10 أحرف فأكثر
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please
# أصل لوحة التحكم للـ CORS
ADMIN_ORIGIN=https://admin.example.com
# توقيع روابط التشغيل (HMAC-SHA256 مع exp وsig). اتركه فارغاً لتعطيله
STREAM_SIGN_SECRET=
STREAM_SIGN_TTL=900
RATE_PER_MIN=240
LOGIN_PER_MIN=10
RUST_LOG=info
